{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cms",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cms-db",
			"database_id": "bf6619ea-a546-45c6-a28a-586dcdb994f4"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "cms-media"
		}
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "cms.mogura.dev",
			"custom_domain": true
		}
	]
}
